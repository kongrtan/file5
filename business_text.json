{
  "id": 1,
  "type": "marcusolsson-dynamictext-panel",
  "title": "MF Worker ID Status",
  "targets": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "editorMode": "code",
      "expr": "sum by (service_instance_id) (max_ids{service_name=~\"mf-worker\"})",
      "legendFormat": "MAX",
      "range": true,
      "refId": "A"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "editorMode": "code",
      "expr": "sum by (service_instance_id) (pool_ids{service_name=~\"mf-worker\"})",
      "legendFormat": "POOL",
      "range": true,
      "refId": "B"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "editorMode": "code",
      "expr": "sum by (service_instance_id) (active_ids{service_name=~\"mf-worker\"})",
      "legendFormat": "ACTIVE",
      "range": true,
      "refId": "C"
    }
  ],
  "transformations": [
    {
      "id": "prepareTimeSeries",
      "options": {
        "format": "single"
      }
    }
  ],
  "options": {
    "content": "<div style=\"display: flex; gap: 16px; align-items: center; justify-content: space-around; padding: 16px; background-color: #181b1f; border-radius: 8px; border: 1px solid #2c3235;\">\n  <div style=\"text-align: center; flex: 1;\">\n    <div style=\"color: #8e8e8e; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; margin-bottom: 4px;\">MAX</div>\n    <div style=\"color: #5794f2; font-size: 26px; font-weight: 700;\">{{MAX}}</div>\n  </div>\n  <div style=\"border-left: 1px solid #333; height: 36px;\"></div>\n  <div style=\"text-align: center; flex: 1;\">\n    <div style=\"color: #8e8e8e; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; margin-bottom: 4px;\">POOL</div>\n    <div style=\"color: #fade2a; font-size: 26px; font-weight: 700;\">{{POOL}}</div>\n  </div>\n  <div style=\"border-left: 1px solid #333; height: 36px;\"></div>\n  <div style=\"text-align: center; flex: 1;\">\n    <div style=\"color: #8e8e8e; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; margin-bottom: 4px;\">ACTIVE</div>\n    <div style=\"color: #73bf69; font-size: 26px; font-weight: 700;\">{{ACTIVE}}</div>\n  </div>\n</div>",
    "defaultContent": "No data available",
    "everyRow": true,
    "editorMode": "code",
    "editorLanguage": "html"
  }
}
